# ==========================================
# Application Specific
# ==========================================
# Ignore all downloaded ZIPs and generated JSON tiles
public/data/*
!public/data/.gitkeep

# 【例外】都心5区（千代田、中央、港、新宿、渋谷）のZIPと、必須の固定ファイルのみコミット対象にする
!public/data/13101-*.zip
!public/data/13102-*.zip
!public/data/13103-*.zip
!public/data/13104-*.zip
!public/data/13113-*.zip
!public/data/local_govs.json

# Ignore intermediate tiles directory (if used outside data/)
public/tiles/

